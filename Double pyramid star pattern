#include <stdio.h>
int main() {
    int rows, i, j, space, stars;

    printf("Enter the number of rows for the half-section: ");
    scanf("%d", &rows);

    for (i = 1; i <= 2*rows - 1; i++) {

        int level = (i <= rows) ? i : 2*rows - i;

        for (space = 1; space <= rows - level; space++) {
            printf(" ");
        }

        stars = 2*level - 1;
        for (j = 1; j <= stars; j++) {
            printf("*");
        }

        printf("\n");
    }

    return 0;
}
