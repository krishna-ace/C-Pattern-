#include <stdio.h>

int main() {
    int n, lines;

    printf("Number of characters in a line: ");
    scanf("%d", &n);

    printf("Enter the number of zigzag lines: ");
    scanf("%d", &lines);

    for (int i = 1; i <= lines; i++) {

        // Main diagonal
        for (int r = 1; r <= n; r++) {
            for (int c = 1; c <= n; c++)
                printf((r == c) ? "%d " : "  ", r);
            printf("\n");
        }

        // Opposite diagonal
        for (int r = 1; r <= n; r++) {
            for (int c = 1; c <= n; c++)
                printf((c == n + 1 - r) ? "%d " : "  ", r);
            printf("\n");
        }
    }

    return 0;
}
