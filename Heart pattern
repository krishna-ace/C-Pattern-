#include <stdio.h>

int main() {
    int i, j;

    // Upper part
    for (i = 1; i <= 3; i++) {
        for (j = 1; j <= 17; j++) {
            printf(((j >= 6 - i && j <= 6 + i) || (j >= 12 - i && j <= 12 + i)) ? "*" : " ");
        }
        printf("\n");
    }

    // Lower part
    for (i = 7; i >= 1; i--) {
        for (j = 1; j <= 13; j++) {
            printf((j >= 8 - i && j <= 6 + i) ? "*" : " ");
        }
        printf("\n");
    }

    return 0;
}
